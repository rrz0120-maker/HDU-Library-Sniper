# Use the verified image digest from docs/V3-P4-ACCEPTANCE.md. Never use latest.
HDU_IMAGE=
HDU_WEB_PORT=8000
HDU_DATA_VOLUME=hdu-sniper-v3-data
# Required: base64 encoding of 32 random bytes; keep stable across restarts.
HDU_SNIPER_SECRET_KEY=
# Your authenticated HTTPS proxy / Tailscale Serve hostname (no scheme or path).
HDU_ALLOWED_HOSTS=
# P4 compose hard-disables writes regardless of these values.
HDU_STRICT_MODE=1
HDU_STRICT_WRITES=0
HDU_STRICT_VALIDATED=0
