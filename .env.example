HDU_SNIPER_HOME=/root/.local/share/hdu-library-sniper
HDU_WEB_PORT=8000
# 32 字节 base64 密钥；严格云端模式必填，无有效密钥拒绝启动
# 生成示例：openssl rand -base64 32
HDU_SNIPER_SECRET_KEY=
# 通过自定义域名访问时追加（逗号分隔）；IP 与 localhost 无需配置
HDU_ALLOWED_HOSTS=

# 严格固定方案；真实测试前保持 WRITES=0，真实验收前保持 VALIDATED=0
HDU_STRICT_MODE=1
HDU_STRICT_WRITES=0
HDU_MANUAL_TEST_WRITES=0
HDU_STRICT_VALIDATED=0
